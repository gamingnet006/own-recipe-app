# KH: settings for kh/ops/docker-compose.yml. Copy to `.env` next to this file
# and adjust. Placeholders only; never put real credentials into this file.

# Image to run. Mac: leave as is (built locally). Pi: the released image, e.g.
# ghcr.io/gamingnet006/own-recipe-app:v0.0-arm64 (PC: v0.0-amd64), available from release v0.0.
KH_IMAGE=kuechenhelfer:dev

# Port on this machine for the web app.
KH_PORT=9091

# Where recipes, images and the database are stored. On the Pi: a folder on the SSD.
KH_DATA_DIR=./data

# User and group ID that own the data folder (`id -u` and `id -g` on the host).
KH_PUID=1000
KH_PGID=1000

KH_TZ=Europe/Berlin

# Address the family uses to open the app; with the tunnel e.g. https://kochbuch.example.org (D27).
KH_BASE_URL=http://localhost:9091

# Hours a login stays valid without opening the app (Mealie's default is 48).
KH_TOKEN_TIME=720

# Upper bound for Mealie's RAM (it needs about 250 MB). Lower it on a machine that also runs
# other services, e.g. 768m, so Mealie can never take their memory.
KH_MEMORY_LIMIT=2g

# Share links: recipe pages anyone with the link can open without logging in. Off by default
# (PLAN.md, Leitplanke 1); true shows "Share" in the recipe menu again.
KH_SHARE_LINKS=false

# Optional: iCloud link of another "Kochheft Timer" shortcut (Shortcuts -> Share -> Copy iCloud Link) for
# "Add shortcut" under More -> Timer. Empty keeps Kochheft's own. Only https://www.icloud.com/shortcuts/... counts.
KH_CLOCK_SHORTCUT_URL=

# --- Drafts (D35) ---
# Every recipe that comes in by link, text or photo waits as a draft for a review. These limits
# rarely need changing; remove the # to set one. Photos per draft, MB per photo before shrinking,
# characters of a pasted text, minutes after which a hanging recognition counts as interrupted:
# KH_DRAFT_MAX_IMAGES=5
# KH_DRAFT_MAX_IMAGE_MB=20
# KH_DRAFT_MAX_TEXT=20000
# KH_DRAFT_STALE_MINUTES=15
# Hints on possible duplicates, from 0 to 1: a title this similar alone, or this share of the same
# ingredients together with a title at least this similar:
# KH_DUPLICATE_TITLE=0.85
# KH_DUPLICATE_INGREDIENTS=0.7
# KH_DUPLICATE_TITLE_WITH_INGREDIENTS=0.5
# Language every recipe the AI reads (text, photos, links without recipe data) is translated into,
# as an English name like German, Dutch or English (D36). Recipes already in it cost no extra AI
# request; links with recipe data stay as the page wrote them. Empty: no translation.
KH_RECIPE_LANGUAGE=

# --- AI priority list and bell (D39) ---
# The AI providers are tried in their order; one that fails is skipped for a while. A 429 with a
# wait up to this many seconds is only a short pause; minutes a provider is skipped when its quota
# is used up and it names no wait, or when it cannot be reached; days a notice in the bell is kept;
# minutes between the app's checks for new notices. Remove the # to change one:
# KH_AI_SHORT_PAUSE_SECONDS=120
# KH_AI_QUOTA_PAUSE_MINUTES=60
# KH_AI_DOWN_PAUSE_MINUTES=10
# KH_NOTICE_DAYS=30
# KH_NOTICE_POLL_MINUTES=5

# --- Backup (D21) ---
# API token of an admin user: in Mealie open Profile > API Tokens > Generate.
# Paste it only into your local .env, never into this example file.
KH_BACKUP_API_TOKEN=
# Second storage location, ideally another disk (USB stick, NAS, second SSD).
KH_BACKUP_DIR=./backups
# When to back up (cron syntax, local time): daily at 03:30.
KH_BACKUP_CRON=30 3 * * *
# How many backups to keep at the second location and inside Mealie's data folder.
KH_BACKUP_KEEP=14
KH_BACKUP_KEEP_LOCAL=3
# Seconds Mealie may take to create or restore a backup.
KH_BACKUP_TIMEOUT=300
# Optional Uptime Kuma push URL (monitor type "Push"); empty means no notification. The backup
# runs in a container: for Uptime Kuma on this machine write host.docker.internal instead of
# localhost, e.g. http://host.docker.internal:3001/api/push/<token>. The nightly copy to a drive
# (backup_copy.sh) reports to the same monitor.
KH_BACKUP_PUSH_URL=
# Encrypted copy of the backups on a removable drive such as a USB stick (D32). Both are set by
# `kh/ops/backup_copy.sh on <folder>`, which asks whether the copies get a password: the folder on
# the drive and the public key the copies are encrypted for, or none for plain copies. The private
# key lies on the drive, locked with your password.
KH_BACKUP_COPY_DIR=
KH_BACKUP_COPY_KEY=

# --- Access from outside (tunnel.sh, D27) ---
# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels. Paste it only into your local
# .env, never into this example file. Only one machine may run the tunnel at a time.
KH_TUNNEL_TOKEN=

# --- Update (update.sh) ---
# Seconds a new version may take to start and migrate the database before update.sh rolls back.
KH_UPDATE_TIMEOUT=600

# --- Automatic updates (auto_update.sh, D29) ---
# Every night at 4:00 the newest stable release (vX.Y or vX.Y.Z, never -rc) is installed
# through update.sh. false switches it off; kh/ops/auto_update.sh on|off sets this too.
KH_AUTO_UPDATE=true
# Only while the images are private: GitHub user and a token that may only read packages
# (read:packages). Paste the token only into your local .env, never into this example file.
KH_REGISTRY_USER=
KH_REGISTRY_TOKEN=
# Optional Uptime Kuma push URL for the result of each night; empty means no notification.
# This one is sent from the machine itself, e.g. http://localhost:3001/api/push/<token>.
KH_UPDATE_PUSH_URL=

# --- About page and system check ---
# Where the source of this fork can be read (AGPL, shown on "More > About Kochheft"); empty keeps the default.
KH_SOURCE_URL=
# Optional modules: only whether they are set shows in "More > System check", never the value.
# Paste real values only into your local .env, never into this example file.
# Telegram bot (README: "Telegram-Bot einrichten"): bot token from @BotFather in Telegram; the chat IDs
# that may use the bot (comma list; write to the bot once and it answers with your ID); and a Kochheft
# API token of its own (Profile > API Tokens, e.g. "Telegram-Bot"). Start: docker compose --profile telegram up -d telegram
KH_TELEGRAM_TOKEN=
KH_TELEGRAM_ALLOWED_IDS=
KH_TELEGRAM_API_TOKEN=

# --- Profile and Whisper (README: "Profile und Hardware-Test", "Audio und Video (Whisper)") ---
# How much the host can carry: leicht (Raspberry Pi), normal, stark or lokal (everything stays in the house: no
# Telegram bot, only local AI). It sets the Whisper model: leicht tiny, normal base, stark small, lokal base.
# Run kh/ops/hardware_test.sh for a proposal.
KH_PROFILE=leicht
# Own audio and video files: start the service with `docker compose --profile whisper up -d whisper` and set
# http://whisper:8000 here; empty means no file field. Model only to override the profile (tiny, base, small);
# memory limit of the service; largest recording in MB.
KH_WHISPER_URL=
KH_WHISPER_MODEL=
KH_WHISPER_MEM_LIMIT=2g
# Port of the service on this machine only (hardware_test.sh --audio uses it)
KH_WHISPER_PORT=8000
KH_DRAFT_MAX_MEDIA_MB=95
