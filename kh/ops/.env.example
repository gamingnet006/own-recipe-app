# KH: settings for kh/ops/docker-compose.yml. Copy to `.env` next to this file
# and adjust. Placeholders only; never put real credentials into this file.

# Image to run. Mac: leave as is (built locally). Pi: the released image, e.g.
# ghcr.io/gamingnet006/own-recipe-app:v0.0-arm64 (PC: v0.0-amd64), available from release v0.0.
KH_IMAGE=kuechenhelfer:dev

# Port on this machine for the web app.
KH_PORT=9091

# Where recipes, images and the database are stored. On the Pi: a folder on the SSD.
KH_DATA_DIR=./data

# User and group ID that own the data folder (`id -u` and `id -g` on the host).
KH_PUID=1000
KH_PGID=1000

KH_TZ=Europe/Berlin

# Address the family uses to open the app; with the tunnel e.g. https://kochbuch.example.org (D27).
KH_BASE_URL=http://localhost:9091

# Hours a login stays valid without opening the app (Mealie's default is 48).
KH_TOKEN_TIME=720

# Upper bound for Mealie's RAM (it needs about 250 MB). Lower it on a machine that also runs
# other services, e.g. 768m, so Mealie can never take their memory.
KH_MEMORY_LIMIT=2g

# --- Backup (D21) ---
# API token of an admin user: in Mealie open Profile > API Tokens > Generate.
# Paste it only into your local .env, never into this example file.
KH_BACKUP_API_TOKEN=
# Second storage location, ideally another disk (USB stick, NAS, second SSD).
KH_BACKUP_DIR=./backups
# When to back up (cron syntax, local time): daily at 03:30.
KH_BACKUP_CRON=30 3 * * *
# How many backups to keep at the second location and inside Mealie's data folder.
KH_BACKUP_KEEP=14
KH_BACKUP_KEEP_LOCAL=3
# Seconds Mealie may take to create or restore a backup.
KH_BACKUP_TIMEOUT=300
# Optional Uptime Kuma push URL (monitor type "Push"); empty means no notification. The backup
# runs in a container: for Uptime Kuma on this machine write host.docker.internal instead of
# localhost, e.g. http://host.docker.internal:3001/api/push/<token>.
KH_BACKUP_PUSH_URL=

# --- Access from outside (tunnel.sh, D27) ---
# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels. Paste it only into your local
# .env, never into this example file. Only one machine may run the tunnel at a time.
KH_TUNNEL_TOKEN=

# --- Update (update.sh) ---
# Seconds a new version may take to start and migrate the database before update.sh rolls back.
KH_UPDATE_TIMEOUT=600

# --- Automatic updates (auto_update.sh, D29) ---
# Every night at 4:00 the newest stable release (vX.Y or vX.Y.Z, never -rc) is installed
# through update.sh. false switches it off; kh/ops/auto_update.sh on|off sets this too.
KH_AUTO_UPDATE=true
# Only while the images are private: GitHub user and a token that may only read packages
# (read:packages). Paste the token only into your local .env, never into this example file.
KH_REGISTRY_USER=
KH_REGISTRY_TOKEN=
# Optional Uptime Kuma push URL for the result of each night; empty means no notification.
# This one is sent from the machine itself, e.g. http://localhost:3001/api/push/<token>.
KH_UPDATE_PUSH_URL=
